<?xml version="1.0" encoding="utf-8"?>
<!-- The widget bubble's base: a white rounded rectangle, colored in code
     (a color filter) with the first profile color. A shape, not a picture,
     so its edge stays sharp at any size and while it's being dragged. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="24dp" />
</shape>
