<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App notifications (supporters): the check is put back on schedule
         after the phone restarts, and Stellar may ask (once) to be left
         running in the background so the check isn't held back for hours. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "Scrobble Music to Rocksky" (supporters): while it's switched on,
         a quiet permanent notification keeps the listener running with the
         screen off, and the phone is kept awake while music is playing so
         listening time is counted properly. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Item 8: the camera-notch button's "Camera" action launches the
         system camera app via an implicit intent (no permission needed for
         that itself), but VRM mode's own live preview needs direct camera
         access in-app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- VRM mode video recording: the mic track (optional; video still records without it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Audio visualizer: attaching an audio effect to the output mix. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Item 8's "Camera" tap resolves MediaStore.ACTION_IMAGE_CAPTURE via
         PackageManager.resolveActivity() to decide whether to show "No
         camera app found". Since this app targets API 30+, package
         visibility rules mean that query sees NO activities at all -
         not even a camera app that's actually installed - unless it's
         explicitly declared here. Without this <queries> block,
         resolveActivity() always returns null and the toast fires every
         time, regardless of whether a camera app exists on the device. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- largeHeap: VRM mode holds the whole .vrm file (often 30-80 MB) in
         memory while Filament loads it; the default 256 MB heap is shared
         with the feed's image/network caches. -->
    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:label="Stellar"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaViewer"
        android:hardwareAccelerated="true">

        <!-- singleTask: a Bluesky profile link opened from the camera, a
             browser or another app lands in the Stellar that's already
             running (onNewIntent) instead of starting a second copy. -->
        <activity
            android:name="com.mediaviewer.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Bluesky profile links (bsky.app/profile/...) can open in
                 Stellar. Android only sends https links to an app once
                 you allow it: Android Settings → Apps → Stellar → Open by
                 default → Add link → bsky.app (Stellar's Settings has a
                 shortcut straight there). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="bsky.app" />
                <data android:host="www.bsky.app" />
                <data android:pathPrefix="/profile/" />
            </intent-filter>
        </activity>

        <!-- Account switching: relaunches the app in a fresh process — see
             RestartActivity's doc comment for why this has to live in its
             own process. -->
        <activity
            android:name="com.mediaviewer.RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Live Link widget: only ever created from within the app via
             requestPinAppWidget() (Settings' "Create Widget" button) — see
             the feature request ("should only be creatable from the app via
             a button next to the links in settings"), never surfaced in the
             system's normal long-press widget picker flow, though Android
             itself doesn't allow fully hiding a provider from that picker;
             it just won't be functional without a saved link either way. -->
        <receiver
            android:name="com.mediaviewer.widget.LiveLinkWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mediaviewer.widget.ACTION_TWITCH" />
                <action android:name="com.mediaviewer.widget.ACTION_YOUTUBE" />
                <action android:name="com.mediaviewer.widget.ACTION_END" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/live_link_widget_info" />
        </receiver>

        <!-- App notifications: the repeating alarm that wakes the check,
             and putting it back after a restart / an update of Stellar. -->
        <receiver
            android:name="com.mediaviewer.worker.StellarNotificationAlarm"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mediaviewer.worker.ACTION_CHECK_NOTIFICATIONS" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Scrobble Music to Rocksky" (supporters; Settings › Integrations).
             The listener is what Android connects once Stellar has been
             given "notification access": it sees which song the chosen
             music apps are playing (the same details the lock screen
             shows). The job sends saved listens when there's a connection;
             the receiver puts both back after a restart or an update. -->
        <service
            android:name="com.mediaviewer.scrobble.StellarScrobbleListener"
            android:label="Stellar scrobbling"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled music scrobbling: observe other players' media sessions and save listens while the screen is off" />
        </service>
        <!-- History import's "Work in Background": a quiet notification with
             the import's progress, shown only while listens are left to send. -->
        <service
            android:name="com.mediaviewer.scrobble.ScrobbleImportService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started import of their own music listening history, written to their account at a rate-limited pace over hours or days" />
        </service>
        <service
            android:name="com.mediaviewer.scrobble.ScrobbleUploadJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.mediaviewer.scrobble.ScrobbleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Stellar's home-screen widgets (supporters): DMs, Upcoming
             Events and a Note. All three are resizable lists. -->
        <receiver
            android:name="com.mediaviewer.widget.DmWidgetProvider"
            android:label="@string/widget_dms_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stellar_widget_dms_info" />
        </receiver>
        <receiver
            android:name="com.mediaviewer.widget.EventsWidgetProvider"
            android:label="@string/widget_events_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stellar_widget_events_info" />
        </receiver>
        <receiver
            android:name="com.mediaviewer.widget.NoteWidgetProvider"
            android:label="@string/widget_note_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/stellar_widget_note_info" />
        </receiver>
        <service
            android:name="com.mediaviewer.widget.StellarWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Item 8: lets the camera-notch button hand the system camera app
             a content:// Uri (under this app's own cache dir) to save the
             captured photo/video into, and get it back afterward. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
