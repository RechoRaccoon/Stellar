<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Stellar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- stellar:// links: a tapped home-screen widget opens the app on
	     that chat / the calendar / that note. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>rechoraccoon.stellar</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>stellar</string>
			</array>
		</dict>
	</array>
	<!-- Notifications while Stellar is closed: iOS wakes the app now and
	     then ("background app refresh") to check for new DMs / Inbox
	     activity. The identifier is the one in IosNotifications.kt. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>rechoraccoon.stellar.refresh</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Let ProMotion iPhones run Compose above 60 fps. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The notch bubble's Camera page (photos and videos for posts).
	     iOS closes an app that opens the camera without these two. -->
	<key>NSCameraUsageDescription</key>
	<string>Stellar uses the camera to take photos and videos for your posts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Stellar uses the microphone to record sound with the videos you take.</string>
	<!-- Stellar only uses the encryption built into iOS (https), so App
	     Store Connect doesn't need to ask about export rules per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Stellar saves images and videos you download to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Stellar lets you pick photos and videos to post.</string>
	<!-- The moment before the app draws: black, like the app's own
	     first frame (an empty launch screen is white in light mode). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Rotates like the Android app (landscape post view etc.). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<!-- Full screen like the Android app (no clock/battery bar). -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Exported files (tagged-post datasets) show up in the Files app
	     under On My iPhone › Stellar. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
